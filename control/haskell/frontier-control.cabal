cabal-version: 2.4
name: frontier-control
version: 0.1.0.0
license: MIT
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules: Control.Pricing, Control.Workflow
  build-depends: base >=4.14 && <5, time >=1.9
  default-language: Haskell2010

test-suite control-laws
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends: base, time, frontier-control
  default-language: Haskell2010
